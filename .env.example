# API Keys
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""

# YouTube Data API v3 (para discursiva de masas, Fase 4)
YOUTUBE_API_KEY=""

# Reddit API (crear app gratuita en https://www.reddit.com/prefs/apps -> "script")
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# LLM configuration
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODELO="deepseek-chat"
# Timeout (segundos) por llamada LLM; evita que un proveedor lento congele el ciclo.
LLM_TIMEOUT="300"

# Destilación 27 (coordenadas nodo x m/l/s)
# El clasificador local qwen3 (Ollama) fue retirado del proyecto por errores;
# la dimensión la resuelve DeepSeek. Los embeddings locales bge-m3 se mantienen
# opcionalmente (requieren Ollama sirviendo /api/embed en OLLAMA_HOST):
#   LLM_LOCAL_EMBED="bge-m3"
#   DIMENSIONES_OLLAMA=0        # 0 desactiva también los embeddings locales
# Dataset de desacuerdos (alumno=estructural vs maestro=DeepSeek):
#   DIM_ALUMNO_MAESTRO=1
#   DIM_ALUMNO_MAX_MAESTRO=20

# Data directory (defaults to ~/.local/share/topologia-social/data)
DATA_DIR=""

# Auth
# Protege los endpoints costosos del servidor web (/api/observe, /api/daily,
# POST /api/learn). El cliente debe enviar el header "X-API-Key" con este valor.
# Si queda vacía, esos endpoints devuelven 503 (bloqueados por seguridad).
API_AUTH_KEY=""

# Logging
LOG_LEVEL=info

# Schedule
TOPO_SCHEDULE_HOUR=8
TOPO_SCHEDULE_MINUTE=0
TOPO_AUTO_START=false

# Web server
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
