# API Keys
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""

# YouTube Data API v3 (para discursiva de masas, Fase 4)
YOUTUBE_API_KEY=""

# Reddit API (crear app gratuita en https://www.reddit.com/prefs/apps -> "script")
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# LLM configuration
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODELO="deepseek-chat"

# Data directory (defaults to ~/.local/share/topologia-social/data)
DATA_DIR=""

# Auth
API_AUTH_KEY=""

# Logging
LOG_LEVEL=info

# Schedule
TOPO_SCHEDULE_HOUR=8
TOPO_SCHEDULE_MINUTE=0
TOPO_AUTO_START=false

# Web server
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
